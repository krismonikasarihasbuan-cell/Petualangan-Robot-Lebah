/* ============================================================
   MAP RENDERING
   ============================================================ */
function renderMap() {
  const container = $('mapContainer');
  container.innerHTML = '';
  const w = container.clientWidth || 800;
  const h = container.clientHeight || 400;

  // Posisi 5 node dalam pola zigzag
  const positions = [
    { x: 0.08, y: 0.65 },
    { x: 0.28, y: 0.25 },
    { x: 0.50, y: 0.65 },
    { x: 0.72, y: 0.25 },
    { x: 0.92, y: 0.65 }
  ];

  // Gambar garis penghubung
  for (let i=0;i<positions.length-1;i++) {
    const a = positions[i], b = positions[i+1];
    const x1 = a.x*w + 65, y1 = a.y*h + 65;
    const x2 = b.x*w + 65, y2 = b.y*h + 65;
    const dx = x2-x1, dy = y2-y1;
    const len = Math.sqrt(dx*dx + dy*dy);
    const angle = Math.atan2(dy,dx) * 180/Math.PI;
    const line = document.createElement('div');
    line.className = 'path-line';
    line.style.width = len + 'px';
    line.style.left = x1 + 'px';
    line.style.top = y1 + 'px';
    line.style.transform = `rotate(${angle}deg)`;
    line.style.transformOrigin = '0 0';
    container.appendChild(line);
  }

  LEVELS.forEach((lvl, i) => {
    const pos = positions[i];
    const node = document.createElement('div');
    node.className = 'level-node';
    const completed = GameState.completedLevels.includes(lvl.id);
    const locked = lvl.id > 1 && !GameState.completedLevels.includes(lvl.id - 1);
    if (completed) node.classList.add('completed');
    if (locked) node.classList.add('locked');
    node.style.left = (pos.x*w) + 'px';
    node.style.top  = (pos.y*h) + 'px';
    node.innerHTML = `
      <div class="node-icon">${lvl.icon}</div>
      <div class="node-name">Lv ${lvl.id}</div>
      <div class="node-name" style="font-size:0.65em;">${lvl.island}</div>
      ${completed?'<div class="node-stars">⭐⭐⭐</div>':'<div class="node-stars" style="color:#5D4037;font-size:0.75em;">🔒</div>'}
    `;
    if (!locked) node.onclick = () => { sfxClick(); startLevel(lvl.id); };
    container.appendChild(node);
  });
}

/* ============================================================
   GAME ENGINE
   ============================================================ */
let gameSession = null;

function startLevel(levelId) {
  const lvl = LEVELS.find(l => l.id === levelId);
  gameSession = {
    levelId,
    level: lvl,
    qIndex: 0,
    correct: 0,
    wrong: 0,
    answered: false,
    selected: null,   // untuk mc/tf
    selectedSet: new Set(), // untuk multi
    pairedCards: new Set(), // untuk pair
    pairTmp: null,
    usedHint: false,
    isLastLevel: levelId === 5
  };
  GameState.totalQuestions += lvl.questions.length;
  GameState.levelStats[levelId] = { correct:0, wrong:0, asked:0 };
  showScreen('game');
  bimoSay(lvl.bimo);
  loadQuestion();
}

function loadQuestion() {
  const s = gameSession;
  const q = s.level.questions[s.qIndex];
  s.answered = false;
  s.selected = null;
  s.selectedSet.clear();
  s.pairedCards.clear();
  s.pairTmp = null;
  s.usedHint = false;

  $('hudLevel').textContent = `Lv ${s.levelId}: ${s.level.island}`;
  updateHUD();
  $('questionBox').innerHTML = q.q;
  $('feedbackBox').textContent = '';
  $('feedbackBox').className = 'feedback-box';
  $('btnCheck').disabled = true;
  $('btnCheck').style.display = 'inline-block';
  $('btnNext').style.display = 'none';
  $('btnHint').disabled = false;
  bimoSay(s.level.bimo);

  const grid = $('cardsGrid');
  grid.innerHTML = '';

  if (q.type === 'mc') {
    q.options.forEach(opt => {
      const card = document.createElement('button');
      card.className = 'num-card';
      card.textContent = opt;
      card.onclick = () => selectMC(card, opt);
      grid.appendChild(card);
    });
  } else if (q.type === 'multi') {
    q.options.forEach(opt => {
      const card = document.createElement('button');
      card.className = 'num-card';
      card.textContent = opt;
      card.onclick = () => toggleMulti(card, opt);
      grid.appendChild(card);
    });
  } else if (q.type === 'tf') {
    ['Benar','Salah'].forEach(opt => {
      const card = document.createElement('button');
      card.className = 'num-card';
      card.style.fontSize = '1.1em';
      card.textContent = opt;
      card.onclick = () => selectMC(card, opt);
      grid.appendChild(card);
    });
  } else if (q.type === 'pair') {
    // Tampilkan kartu angka untuk dipasangkan
    const all = [...q.options].sort(() => Math.random() - 0.5);
    all.forEach(opt => {
      const card = document.createElement('button');
      card.className = 'num-card';
      card.textContent = opt;
      card.dataset.val = opt;
      card.onclick = () => handlePairClick(card, opt);
      grid.appendChild(card);
    });
    // Instruksi
    const info = document.createElement('div');
    info.style.gridColumn = '1/-1';
    info.style.fontSize = '0.9em';
    info.style.color = '#8B4513';
    info.textContent = 'Klik dua angka untuk membentuk pasangan perkalian.';
    grid.appendChild(info);
  }
}

function updateHUD() {
  $('hudScore').textContent = GameState.score;
  $('hudCorrect').textContent = GameState.correctAnswers;
  $('hudTotal').textContent = GameState.totalQuestions;
  const s = gameSession;
  const prog = s ? ((s.qIndex) / s.level.questions.length) * 100 : 0;
  $('hudProgress').style.width = prog + '%';
}

/* ---------- JAWABAN: MC / TF ---------- */
function selectMC(card, val) {
  if (gameSession.answered) return;
  sfxClick();
  document.querySelectorAll('#cardsGrid .num-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
  gameSession.selected = val;
  $('btnCheck').disabled = false;
}

/* ---------- JAWABAN: MULTI ---------- */
function toggleMulti(card, val) {
  if (gameSession.answered) return;
  sfxClick();
  if (gameSession.selectedSet.has(val)) {
    gameSession.selectedSet.delete(val);
    card.classList.remove('selected');
  } else {
    gameSession.selectedSet.add(val);
    card.classList.add('selected');
  }
  $('btnCheck').disabled = gameSession.selectedSet.size === 0;
}

/* ---------- JAWABAN: PAIR ---------- */
function handlePairClick(card, val) {
  if (gameSession.answered) return;
  if (gameSession.pairedCards.has(val)) return;
  sfxClick();

  if (gameSession.pairTmp === null) {
    gameSession.pairTmp = { val, card };
    card.classList.add('selected');
  } else if (gameSession.pairTmp.val === val) {
    // klik angka yang sama → batal
    card.classList.remove('selected');
    gameSession.pairTmp = null;
  } else {
    // Cek pasangan
    const q = gameSession.level.questions[gameSession.qIndex];
    const a = gameSession.pairTmp.val, b = val;
    const isPair = q.pairs.some(([x,y]) => (x===a&&y===b)||(x===b&&y===a));
    const tmpCard = gameSession.pairTmp.card;

    if (isPair) {
      tmpCard.classList.remove('selected');
      tmpCard.classList.add('paired');
      card.classList.add('paired');
      gameSession.pairedCards.add(a);
      gameSession.pairedCards.add(b);
      sfxCorrect();
      // Cek jika semua pasangan sudah ketemu
      const needed = new Set(q.pairs.flat());
      const done = [...needed].every(v => gameSession.pairedCards.has(v));
      if (done) {
        // Semua pasangan ketemu → otomatis benar
        gameSession.selected = '__pair_done__';
        $('btnCheck').disabled = false;
        bimoSay('Semua pasangan ketemu! Klik Periksa, ya!');
      }
    } else {
      sfxWrong();
      tmpCard.classList.remove('selected');
      tmpCard.classList.add('wrong');
      card.classList.add('wrong');
      setTimeout(() => {
        tmpCard.classList.remove('wrong');
        card.classList.remove('wrong');
      }, 500);
      bimoSay('Hmm, itu bukan pasangan yang tepat. Coba lagi!');
    }
    gameSession.pairTmp = null;
  }
}

/* ---------- HINT ---------- */
$('btnHint').onclick = () => {
  if (!gameSession || gameSession.answered) return;
  const q = gameSession.level.questions[gameSession.qIndex];
  gameSession.usedHint = true;
  sfxClick();
  let hint = '';
  if (q.type === 'mc') {
    hint = 'Ingat: faktor tidak menghasilkan sisa ketika membagi bilangan. Coba bagi bilangan dengan setiap pilihan.';
  } else if (q.type === 'multi') {
    hint = 'Cari semua angka yang bisa membagi bilangan tersebut tanpa sisa. Mulai dari 1, lalu 2, 3, dst.';
  } else if (q.type === 'tf') {
    hint = 'Coba bagi bilangan dengan angka yang disebutkan. Jika tidak ada sisa, berarti faktor.';
  } else if (q.type === 'pair') {
    hint = 'Pasangan perkalian contohnya 1 × bilangan, 2 × ..., dst. Cari angka yang jika dikalikan hasilnya bilangan target.';
  }
  bimoSay('💡 ' + hint);
  $('btnHint').disabled = true;
};

/* ---------- CHECK ANSWER ---------- */
$('btnCheck').onclick = () => {
  if (!gameSession || gameSession.answered) return;
  const s = gameSession;
  const q = s.level.questions[s.qIndex];
  s.answered = true;

  let isCorrect = false;
  let points = 100;

  if (q.type === 'mc') {
    isCorrect = (s.selected === q.correct);
    highlightMC(q.correct, s.selected);
  } else if (q.type === 'tf') {
    const ansStr = s.selected === 'Benar' ? true : false;
    isCorrect = (ansStr === q.correct);
    // tandai benar
    document.querySelectorAll('#cardsGrid .num-card').forEach(c => {
      const isRight = (c.textContent === 'Benar') === q.correct;
      if (isRight) c.classList.add('correct');
      else if (c.classList.contains('selected')) c.classList.add('wrong');
      c.disabled = true;
    });
  } else if (q.type === 'multi') {
    const correctSet = new Set(q.correct);
    const selSet = s.selectedSet;
    const allFound = correctSet.size === selSet.size && [...correctSet].every(v => selSet.has(v));
    isCorrect = allFound;
    // tandai
    document.querySelectorAll('#cardsGrid .num-card').forEach(c => {
      const v = parseInt(c.textContent);
      c.disabled = true;
      if (selSet.has(v) && correctSet.has(v)) c.classList.add('correct');
      else if (selSet.has(v) && !correctSet.has(v)) c.classList.add('wrong');
      else if (!selSet.has(v) && correctSet.has(v)) c.classList.add('missed');
    });
    // Badge khusus: Pemburu Faktor (menemukan seluruh faktor benar pada 1 tantangan)
    if (isCorrect) grantBadge('pemburu');
  } else if (q.type === 'pair') {
    // Sudah dikelola di handlePairClick
    const needed = new Set(q.pairs.flat());
    const done = [...needed].every(v => s.pairedCards.has(v));
    isCorrect = done;
    document.querySelectorAll('#cardsGrid .num-card').forEach(c => c.disabled = true);
  }

  if (isCorrect) {
    if (s.usedHint) points = 70;
    GameState.score += points;
    s.correct++;
    GameState.correctAnswers++;
    GameState.levelStats[s.levelId].correct++;
    sfxCorrect();
    bimoCelebrate();
    const rect = $('cardsGrid').getBoundingClientRect();
    spawnSparkles(rect.left + rect.width/2, rect.top + rect.height/2, 8);
    const praise = ['Hebat! 🎉','Kamu makin jago matematika! 🌟','Mantap! ✨','Luar biasa! 🐝','Pintar sekali! 💯'];
    bimoSay(praise[Math.floor(Math.random()*praise.length)]);
    $('feedbackBox').textContent = `✅ Benar! +${points} madu poin.`;
    $('feedbackBox').className = 'feedback-box correct';
  } else {
    s.wrong++;
    GameState.wrongAnswers++;
    GameState.levelStats[s.levelId].wrong++;
    sfxWrong();
    bimoSad();
    const enc = ['Ayo, kita coba lagi! 💪','Tidak apa-apa, terus semangat! 🌈','Hampir benar, ayo teliti lagi! 🐝'];
    bimoSay(enc[Math.floor(Math.random()*enc.length)]);
    let msg = '❌ Belum tepat. ';
    if (q.explain) msg += q.explain;
    else if (q.type === 'multi') msg += 'Beberapa faktor belum tepat. Ingat, faktor tidak menghasilkan sisa.';
    else if (q.type === 'pair') msg += 'Pasangan perkalian belum lengkap.';
    $('feedbackBox').textContent = msg;
    $('feedbackBox').className = 'feedback-box wrong';
    if (q.type === 'mc') GameState.weakTopics.add('Menentukan faktor bilangan');
    else if (q.type === 'multi') GameState.weakTopics.add('Mencari semua faktor');
    else if (q.type === 'pair') GameState.weakTopics.add('Pasangan perkalian');
    else if (q.type === 'tf') GameState.weakTopics.add('Membedakan faktor dan bukan faktor');
  }

  updateHUD();
  $('btnCheck').style.display = 'none';
  $('btnHint').disabled = true;
  $('btnNext').style.display = 'inline-block';
  $('btnNext').textContent = (s.qIndex < s.level.questions.length - 1) ? '➡️ Soal Berikutnya' : '🏁 Selesai Level';
};

function highlightMC(correctVal, selectedVal) {
  document.querySelectorAll('#cardsGrid .num-card').forEach(c => {
    const v = c.textContent;
    // Untuk tf
    if (typeof correctVal === 'boolean') {
      const isRight = (v === 'Benar') === correctVal;
      if (isRight) c.classList.add('correct');
      else if (c.classList.contains('selected')) c.classList.add('wrong');
      c.disabled = true;
      return;
    }
    c.disabled = true;
    if (v == correctVal) c.classList.add('correct');
    else if (v == selectedVal) c.classList.add('wrong');
  });
}

/* ---------- NEXT ---------- */
$('btnNext').onclick = () => {
  const s = gameSession;
  sfxClick();
  if (s.qIndex < s.level.questions.length - 1) {
    s.qIndex++;
    loadQuestion();
  } else {
    finishLevel();
  }
};

/* ---------- FINISH LEVEL ---------- */
function finishLevel() {
  const s = gameSession;
  // Bonus level
  GameState.score += 200;

  // Badge khusus per level
  if (s.levelId === 1) grantBadge('pemula');
  if (s.levelId === 2) grantBadge('sayapEmas');
  if (s.levelId === 5) {
    const stat = GameState.levelStats[5];
    const asked = stat.correct + stat.wrong;
    const acc = asked > 0 ? (stat.correct / asked) * 100 : 0;
    if (acc >= 80) grantBadge('cerdas');
  }

  if (!GameState.completedLevels.includes(s.levelId)) {
    GameState.completedLevels.push(s.levelId);
  }

  sfxLevel();
  bimoCelebrate();

  const isLast = s.levelId === GameState.totalLevels;

  if (isLast) {
    // Selesai semua level
    if (GameState.completedLevels.length === GameState.totalLevels) {
      grantBadge('raja');
      GameState.score += 500;
    }
    setTimeout(showResult, 900);
  } else {
    showModal('🎉','Level Selesai!',
      `Kamu menyelesaikan ${s.level.island}!\nBonus +200 madu.\nSkor: ${GameState.score}`,
      [
        { label:'🗺️ Kembali ke Peta', cls:'btn-primary', action: () => { closeModal(); renderMap(); showScreen('map'); } }
      ]);
  }
}

/* ---------- GRANT BADGE (dengan animasi terbang) ---------- */
function grantBadge(badgeId) {
  if (GameState.badges.includes(badgeId)) return;
  const badge = BADGES[badgeId];
  if (!badge) return;
  GameState.badges.push(badgeId);

  // Tampilkan popup lencana
  $('badgeRewardVisual').innerHTML = renderBadgeSVG(badge, 140);
  $('badgeRewardTitle').textContent = badge.name;
  $('badgeRewardDesc').textContent = 'Kamu mendapatkan lencana ini karena: ' + badge.desc;
  $('badgeRewardPopup').classList.add('show');
  sfxBadge();
}

$('btnCloseBadgePopup').onclick = () => {
  $('badgeRewardPopup').classList.remove('show');
  // Setelah popup tertutup, jalankan animasi lencana terbang
  flyBadgeToCorner();
};

function flyBadgeToCorner() {
  const badgeId = GameState.badges[GameState.badges.length - 1];
  if (!badgeId) return;
  const badge = BADGES[badgeId];
  const flyer = document.createElement('div');
  flyer.className = 'badge-fly';
  flyer.innerHTML = `<div class="badge-hex" style="color:${badge.color};">${renderBadgeSVG(badge,100)}</div>`;
  document.body.appendChild(flyer);
  requestAnimationFrame(() => flyer.classList.add('show'));
  setTimeout(() => flyer.remove(), 3700);
}

/* ---------- SHOW RESULT ---------- */
function showResult() {
  $('rName').textContent = GameState.playerName || 'Petualang';
  $('rScore').textContent = GameState.score;
  $('rCorrect').textContent = GameState.correctAnswers;
  $('rWrong').textContent = GameState.wrongAnswers;
  const total = GameState.correctAnswers + GameState.wrongAnswers;
  const acc = total > 0 ? Math.round((GameState.correctAnswers/total)*100) : 0;
  $('rAccuracy').textContent = acc + '%';
  $('rLevels').textContent = GameState.completedLevels.length + '/' + GameState.totalLevels;
  $('resultGreeting').textContent = `Selamat, ${GameState.playerName || 'Petualang'}! Kamu telah menyelesaikan petualangan!`;

  const topics = [...GameState.weakTopics];
  $('rTopics').innerHTML = topics.length ? '<ul style="margin-left:18px;">' + topics.map(t=>`<li>${t}</li>`).join('') + '</ul>'
                                          : 'Semua materi sudah dikuasai dengan baik! 🎉';

  // Animasi lencana terbang di halaman hasil
  showScreen('result');
  sfxLevel();
  // Lencana beterbangan
  GameState.badges.forEach((bid, i) => {
    setTimeout(() => {
      const b = BADGES[bid];
      const flyer = document.createElement('div');
      flyer.className = 'badge-fly';
      flyer.style.animationDuration = '4s';
      flyer.innerHTML = `<div class="badge-hex" style="color:${b.color};">${renderBadgeSVG(b,80)}</div>`;
      document.body.appendChild(flyer);
      requestAnimationFrame(() => flyer.classList.add('show'));
      setTimeout(() => flyer.remove(), 4200);
    }, i * 400);
  });
}

/* ============================================================
   BADGE COLLECTION SCREEN
   ============================================================ */
function renderBadgeCollection() {
  const cont = $('badgeCollection');
  cont.innerHTML = '';
  Object.values(BADGES).forEach(b => {
    const owned = GameState.badges.includes(b.id);
    const div = document.createElement('div');
    div.className = 'badge-item' + (owned ? '' : ' locked');
    div.innerHTML = `
      ${renderBadgeSVG(b, 100)}
      <div class="badge-name">${b.name}</div>
      <div class="badge-desc">${owned ? b.desc : '🔒 Belum terbuka'}</div>
    `;
    cont.appendChild(div);
  });
}

/* ============================================================
   MODAL
   ============================================================ */
function showModal(emoji, title, message, actions) {
  $('modalEmoji').textContent = emoji;
  $('modalTitle').textContent = title;
  $('modalMessage').innerHTML = message.replace(/\n/g,'<br>');
  const box = $('modalActions');
  box.innerHTML = '';
  (actions || [{label:'OK',cls:'btn-primary',action:closeModal}]).forEach(a => {
    const btn = document.createElement('button');
    btn.className = 'btn ' + (a.cls || 'btn-primary');
    btn.textContent = a.label;
    btn.onclick = a.action;
    box.appendChild(btn);
  });
  $('modalOverlay').classList.add('show');
}
function closeModal() { $('modalOverlay').classList.remove('show'); }

